@model IEnumerable<AcxiomCRM.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Customers</h1>
            <p class="text-muted mb-0">
                Manage your customer records.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Customer
        </a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 align-items-center mb-3">
        <div class="col-12 col-md-8 col-lg-6">
            <input type="search"
                   name="searchTerm"
                   value="@ViewData["SearchTerm"]"
                   class="form-control"
                   placeholder="Search name, email, phone, company, or code"
                   aria-label="Search customers" />
        </div>
        <div class="col-6 col-md-auto">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
        @if (ViewData["SearchTerm"] is string searchTerm && !string.IsNullOrWhiteSpace(searchTerm))
        {
            <div class="col-6 col-md-auto">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        }
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @if (ViewData["SearchTerm"] is string searchTerm && !string.IsNullOrWhiteSpace(searchTerm))
            {
                <span>No customers match your search.</span>
            }
            else
            {
                <span>No customers found. Create your first customer.</span>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Customer</th>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">
                                        @customer.CustomerCode
                                    </span>
                                </td>

                                <td>
                                    @customer.CustomerName
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(customer.CompanyName)
                                        ? "-"
                                        : customer.CompanyName)
                                </td>

                                <td>
                                    @customer.Email
                                </td>

                                <td>
                                    @customer.Phone
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        @customer.Status
                                    </span>
                                </td>

                                <td>
                                    @(customer.CreatedDate.ToLocalTime().ToString("dd MMM yyyy"))
                                </td>

                                          <td class="text-nowrap">
                                                <a asp-action="Details" asp-route-id="@customer.CustomerId"
                                                    class="btn btn-sm btn-outline-secondary">Details</a>
                                                <a asp-action="Edit" asp-route-id="@customer.CustomerId"
                                                    class="btn btn-sm btn-outline-primary">Edit</a>
                                                <a asp-action="Delete" asp-route-id="@customer.CustomerId"
                                                    class="btn btn-sm btn-outline-danger">Delete</a>
                                          </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>