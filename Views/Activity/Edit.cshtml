@model AcxiomCRM.Models.Activity

@{
    ViewData["Title"] = "Edit Activity";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>Edit Activity</h1>
            <p class="text-muted mb-0">Update the activity details.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Activities</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.ActivityId" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="ActivityType" class="form-label"></label>
                <select asp-for="ActivityType" class="form-select">
                    <option value="Call">Call</option>
                    <option value="Meeting">Meeting</option>
                    <option value="Email">Email</option>
                    <option value="Task">Task</option>
                </select>
                <span asp-validation-for="ActivityType" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Subject" class="form-label"></label>
                <input asp-for="Subject" class="form-control" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="ActivityDate" class="form-label"></label>
                <input asp-for="ActivityDate" type="date" class="form-control" />
                <span asp-validation-for="ActivityDate" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Planned">Planned</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="CustomerId" class="form-label">Customer (optional)</label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                    <option value="">No customer selected</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="LeadId" class="form-label">Lead (optional)</label>
                <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                    <option value="">No lead selected</option>
                </select>
                <span asp-validation-for="LeadId" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.ActivityId" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}