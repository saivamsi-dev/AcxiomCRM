@model IEnumerable<AcxiomCRM.Models.Activity>

@{
    ViewData["Title"] = "Activities";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>Activities</h1>
            <p class="text-muted mb-0">Track calls, meetings, emails, and tasks.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Create Activity</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
        <div class="col-12 col-sm-6 col-lg-2">
            <label for="activityType" class="form-label">Activity type</label>
            <select id="activityType" name="activityType" asp-items="ViewBag.ActivityTypes" class="form-select">
                <option value="">All types</option>
            </select>
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
            <label for="activityDate" class="form-label">Activity date</label>
            <input id="activityDate" name="activityDate" type="date" value="@ViewData["ActivityDateFilter"]" class="form-control" />
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
            <label for="status" class="form-label">Status</label>
            <select id="status" name="status" asp-items="ViewBag.Statuses" class="form-select">
                <option value="">All statuses</option>
            </select>
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
            <label for="assignedTo" class="form-label">Assigned user</label>
            <select id="assignedTo" name="assignedTo" asp-items="ViewBag.AssignedUsers" class="form-select">
                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                {
                    <option value="">All users</option>
                }
            </select>
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
            <label for="customerId" class="form-label">Customer</label>
            <select id="customerId" name="customerId" asp-items="ViewBag.Customers" class="form-select">
                <option value="">All customers</option>
            </select>
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
            <label for="leadId" class="form-label">Lead</label>
            <select id="leadId" name="leadId" asp-items="ViewBag.Leads" class="form-select">
                <option value="">All leads</option>
            </select>
        </div>
        <div class="col-6 col-sm-auto">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-6 col-sm-auto">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No activities found for the selected filters.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Description</th>
                        <th>Customer</th>
                        <th>Lead</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var activity in Model)
                    {
                        <tr>
                            <td>@activity.ActivityDate?.ToString("dd MMM yyyy")</td>
                            <td>@activity.ActivityType</td>
                            <td>@activity.Subject</td>
                            <td>@(string.IsNullOrWhiteSpace(activity.Description) ? "-" : activity.Description)</td>
                            <td>@(activity.Customer?.CustomerName ?? "-")</td>
                            <td>@(activity.Lead is null ? "-" : $"{activity.Lead.LeadCode} - {activity.Lead.LeadName}")</td>
                            <td>@activity.Status</td>
                            <td>@(activity.AssignedUser?.FullName ?? activity.AssignedUser?.Email ?? activity.AssignedTo)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>