@model AcxiomCRM.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="container mt-4">
    <h1>Delete Activity</h1>
    <p>Are you sure you want to delete this activity?</p>

    <dl class="row">
        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.ActivityType</dd>

        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>

        <dt class="col-sm-3">Activity Date</dt>
        <dd class="col-sm-9">@Model.ActivityDate?.ToString("dd MMM yyyy")</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@(Model.Customer?.CustomerName ?? "-")</dd>

        <dt class="col-sm-3">Lead</dt>
        <dd class="col-sm-9">@(Model.Lead is null ? "-" : $"{Model.Lead.LeadCode} - {Model.Lead.LeadName}")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.ActivityId" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Delete Activity</button>
        <a asp-action="Details" asp-route-id="@Model.ActivityId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>