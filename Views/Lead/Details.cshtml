@model AcxiomCRM.Models.Lead

@{
    ViewData["Title"] = "Lead Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Lead Details</h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.LeadId" class="btn btn-outline-danger">Delete</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to Leads</a>
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Lead ID</dt>
        <dd class="col-sm-9">@Model.LeadId</dd>

        <dt class="col-sm-3">Lead Code</dt>
        <dd class="col-sm-9">@Model.LeadCode</dd>

        <dt class="col-sm-3">Lead Name</dt>
        <dd class="col-sm-9">@Model.LeadName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Phone</dd>

        <dt class="col-sm-3">Company</dt>
        <dd class="col-sm-9">@(Model.CompanyName ?? "-")</dd>

        <dt class="col-sm-3">Source</dt>
        <dd class="col-sm-9">@Model.Source</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Expected Value</dt>
        <dd class="col-sm-9">@Model.ExpectedValue.ToString("C")</dd>

        <dt class="col-sm-3">Created Date</dt>
        <dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>

        <dt class="col-sm-3">Assigned To</dt>
        <dd class="col-sm-9">@(Model.AssignedUser?.FullName ?? Model.AssignedTo ?? "-")</dd>
    </dl>
</div>