@model AcxiomCRM.Models.Lead

@{
    ViewData["Title"] = "Delete Lead";
}

<div class="container mt-4">
    <h1>Delete Lead</h1>
    <p>Are you sure you want to delete this lead?</p>

    <dl class="row">
        <dt class="col-sm-3">Lead Code</dt>
        <dd class="col-sm-9">@Model.LeadCode</dd>

        <dt class="col-sm-3">Lead Name</dt>
        <dd class="col-sm-9">@Model.LeadName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Phone</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.LeadId" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Delete Lead</button>
        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>