@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Delete Follow-Up";
}

<div class="container mt-4">
    <h1>Delete Follow-Up</h1>
    <p>Are you sure you want to delete this follow-up?</p>

    <dl class="row">
        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.FollowUpDate?.ToString("dd MMM yyyy")</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.FollowUpType</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@(Model.Customer?.CustomerName ?? "-")</dd>

        <dt class="col-sm-3">Lead</dt>
        <dd class="col-sm-9">@(Model.Lead is null ? "-" : $"{Model.Lead.LeadCode} - {Model.Lead.LeadName}")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.FollowUpId" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Delete Follow-Up</button>
        <a asp-action="Details" asp-route-id="@Model.FollowUpId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>