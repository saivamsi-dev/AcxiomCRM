@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Edit Follow-Up";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>Edit Follow-Up</h1>
            <p class="text-muted mb-0">Update the follow-up details.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Follow-Ups</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.FollowUpId" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="CustomerId" class="form-label">Customer (optional if a lead is selected)</label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                    <option value="">No customer selected</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="LeadId" class="form-label">Lead (optional if a customer is selected)</label>
                <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                    <option value="">No lead selected</option>
                </select>
                <span asp-validation-for="LeadId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="FollowUpDate" class="form-label"></label>
                <input asp-for="FollowUpDate" type="date" class="form-control" />
                <span asp-validation-for="FollowUpDate" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="FollowUpType" class="form-label"></label>
                <input asp-for="FollowUpType" class="form-control" />
                <span asp-validation-for="FollowUpType" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Planned">Planned</option>
                    <option value="Completed">Completed</option>
                    <option value="Missed">Missed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.FollowUpId" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}