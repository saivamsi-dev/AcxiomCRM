@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Follow-Up Details";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1>Follow-Up Details</h1>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.FollowUpId" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.FollowUpId" class="btn btn-outline-danger">Delete</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to Follow-Ups</a>
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Follow-Up ID</dt>
        <dd class="col-sm-9">@Model.FollowUpId</dd>

        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.FollowUpDate?.ToString("dd MMM yyyy")</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.FollowUpType</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@(Model.Customer?.CustomerName ?? "-")</dd>

        <dt class="col-sm-3">Lead</dt>
        <dd class="col-sm-9">@(Model.Lead is null ? "-" : $"{Model.Lead.LeadCode} - {Model.Lead.LeadName}")</dd>

        <dt class="col-sm-3">Remarks</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Assigned To</dt>
        <dd class="col-sm-9">@(Model.AssignedUser?.FullName ?? Model.AssignedUser?.Email ?? Model.AssignedTo)</dd>
    </dl>
</div>