@model IEnumerable<AcxiomCRM.Models.Opportunity>

@{
    ViewData["Title"] = "Opportunities";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>Opportunities</h1>
            <p class="text-muted mb-0">Manage your sales opportunities.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Create Opportunity</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No opportunities found. Create your first opportunity.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Opportunity</th>
                        <th>Customer</th>
                        <th>Lead</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Expected Close</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var opportunity in Model)
                    {
                        <tr>
                            <td>@opportunity.OpportunityName</td>
                            <td>@(opportunity.Customer?.CustomerName ?? "-")</td>
                            <td>@(opportunity.Lead is null ? "-" : $"{opportunity.Lead.LeadCode} - {opportunity.Lead.LeadName}")</td>
                            <td>@opportunity.Amount.ToString("C")</td>
                            <td>@opportunity.Stage</td>
                            <td>@opportunity.Probability%</td>
                            <td>@opportunity.ExpectedCloseDate?.ToString("dd MMM yyyy")</td>
                            <td>@opportunity.Status</td>
                            <td>@(opportunity.AssignedUser?.FullName ?? opportunity.AssignedTo)</td>
                                     <td class="text-nowrap">
                                          <a asp-action="Details" asp-route-id="@opportunity.OpportunityId"
                                              class="btn btn-sm btn-outline-secondary">Details</a>
                                          <a asp-action="Edit" asp-route-id="@opportunity.OpportunityId"
                                              class="btn btn-sm btn-outline-primary">Edit</a>
                                          <a asp-action="Delete" asp-route-id="@opportunity.OpportunityId"
                                              class="btn btn-sm btn-outline-danger">Delete</a>
                                     </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>