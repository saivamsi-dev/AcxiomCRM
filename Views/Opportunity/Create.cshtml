@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>Create Opportunity</h1>
            <p class="text-muted mb-0">Add an opportunity to the pipeline.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Opportunities</a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="OpportunityName" class="form-label"></label>
                <input asp-for="OpportunityName" class="form-control" />
                <span asp-validation-for="OpportunityName" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="CustomerId" class="form-label">Customer</label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                    <option value="0">Select a customer</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="LeadId" class="form-label">Lead (optional)</label>
                <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                    <option value="">No linked lead</option>
                </select>
                <span asp-validation-for="LeadId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" type="number" min="0" step="0.01" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Stage" class="form-label"></label>
                <select asp-for="Stage" class="form-select">
                    <option value="Qualification">Qualification</option>
                    <option value="Proposal">Proposal</option>
                    <option value="Negotiation">Negotiation</option>
                    <option value="Won">Won</option>
                    <option value="Lost">Lost</option>
                </select>
                <span asp-validation-for="Stage" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Probability" class="form-label"></label>
                <input asp-for="Probability" type="number" min="0" max="100" step="1" class="form-control" />
                <span asp-validation-for="Probability" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="ExpectedCloseDate" class="form-label"></label>
                <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                <span asp-validation-for="ExpectedCloseDate" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Open">Open</option>
                    <option value="Won">Won</option>
                    <option value="Lost">Lost</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Create Opportunity</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}