@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1>Opportunity Details</h1>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.OpportunityId" class="btn btn-outline-danger">Delete</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to Opportunities</a>
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Opportunity</dt>
        <dd class="col-sm-9">@Model.OpportunityName</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@(Model.Customer?.CustomerName ?? "-")</dd>

        <dt class="col-sm-3">Lead</dt>
        <dd class="col-sm-9">@(Model.Lead is null ? "-" : $"{Model.Lead.LeadCode} - {Model.Lead.LeadName}")</dd>

        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>

        <dt class="col-sm-3">Stage</dt>
        <dd class="col-sm-9">@Model.Stage</dd>

        <dt class="col-sm-3">Probability</dt>
        <dd class="col-sm-9">@Model.Probability%</dd>

        <dt class="col-sm-3">Expected Close Date</dt>
        <dd class="col-sm-9">@Model.ExpectedCloseDate?.ToString("dd MMM yyyy")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Created Date</dt>
        <dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>

        <dt class="col-sm-3">Assigned To</dt>
        <dd class="col-sm-9">@(Model.AssignedUser?.FullName ?? Model.AssignedTo)</dd>
    </dl>
</div>